def _bench_trusted_dir(path: Path, *, create: bool = False) -> None:
    """Check canonical host paths with immutable root-owned ancestors before passing them to Docker."""
    for part in (*reversed(path.parents), path):
        if create and part in (PR31_STATE.parent, PR31_STATE, PR31_DOCKER_CONFIG):
            part.mkdir(mode=0o700, exist_ok=True)
        st = part.lstat()
        needs_root = create or part != path
        if not stat.S_ISDIR(st.st_mode) or (needs_root and (st.st_uid or st.st_mode & 0o022)):
            raise Denied("benchmark mount path has an unsafe ancestor or is not a real directory")


@contextmanager
def _bench_open_dir(parent: int | None, parts: tuple[str, ...], *, input_uid: int | None = None):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    fd = os.dup(parent) if parent is not None else os.open("/", flags)
    try:
        for name in parts:
            nxt = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = nxt
            if input_uid is not None:
                st = os.fstat(fd)
                if not ((st.st_uid == input_uid and st.st_mode & 0o500 == 0o500) or
                        (st.st_uid == 0 and st.st_mode & 0o005 == 0o005)):
                    raise Denied("benchmark input directory must be accessible to asc")
        yield fd
    finally:
        os.close(fd)


@contextmanager
def _bench_regular(parent: int, name: str, uid: int, size_limit: int):
    # O_PATH pins the inode without opening a FIFO or device before checking its type.
    fd = os.open(name, os.O_PATH | os.O_NOFOLLOW, dir_fd=parent)
    try:
        st = os.fstat(fd)
        readable = (st.st_uid == uid and st.st_mode & stat.S_IRUSR) or (
            st.st_uid == 0 and st.st_mode & stat.S_IROTH)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or not readable or st.st_size > size_limit:
            raise Denied("benchmark input must be a readable, bounded regular file without hard links")
        with open(f"/proc/self/fd/{fd}", "rb") as source:
            yield source, st.st_size
    finally:
        os.close(fd)


def _bench_present(parent: int, name: str) -> bool:
    try:
        os.stat(name, dir_fd=parent, follow_symlinks=False)
    except FileNotFoundError:
        return False
    return True


