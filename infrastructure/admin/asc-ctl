def cmd_gpu_validate(conf: dict, args: list[str]) -> int:
    model = None
    repeat = "2"
    i = 0
    while i < len(args):
        if args[i] == "--vlm" and i + 1 < len(args) and MODEL_RE.match(args[i + 1]):
            model = args[i + 1]
            i += 1
        elif args[i] == "--repeat" and i + 1 < len(args) and args[i + 1].isdigit():
            repeat = args[i + 1]
            i += 1
        else:
            raise Denied(f"argument {args[i]!r} not allowed")
        i += 1
    fixtures = os.path.join(repo(conf), "tests", "fixtures")
    base = oneoff_base(conf, True) + ["-e", "ASC_MODELS_DIR=/models", "-v", f"{DATA_ROOT}/models:/models:ro",
                                      "-v", f"{DATA_ROOT}/bench:/bench", "-v", f"{fixtures}:/fixtures:ro",
                                      "--entrypoint", "python3", oneoff_image(conf, env_tag())]
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    rc = run(base + ["-m", "clipper.analysis.gpu_probe", "--out", f"/bench/gpu-probe-{conf['SERVER']}-{stamp}.json"])
    if rc == 0 and model:
        rc = run(base + ["-m", "clipper.analysis.vlm_bench", "--model", model, "--device", "GPU", "--annotations",
                         "/fixtures/annotations.json", "--repeat", repeat,
                         "--out", f"/bench/vlm-{model}-{conf['SERVER']}-{stamp}.json"])
    print(f"results in {DATA_ROOT}/bench/")
    return rc


