    cmd = [DOCKER, "run", "--rm", "--user", f"{CONTAINER_UID}:{CONTAINER_UID}", "--cap-drop", "ALL",
           "--security-opt", "no-new-privileges:true", "--cpus", "4", "--memory", "12g",
           "--label", "com.asc.project=ai-stream-clipper", "-e", "ASC_WORK_DIR=/tmp", "-e", "HOME=/tmp"]
    if conf["SERVER"] == "201":
        cmd += ["--cpu-shares", "256"]
