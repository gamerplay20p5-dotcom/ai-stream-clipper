    shutil.copy(path, dest)
    os.chmod(dest, 0o644)
    print(f"installed {dest}")
    return 0


def pg_hba() -> str:
    lines = ["# written by asc-ctl init (212): only the asc database, only from the API host",
             "local   all   all                 trust",  # inside the container (pg_isready, pg_dump, psql)
             "host    all   all   127.0.0.1/32   scram-sha-256"]
    lines += [f"host    asc   asc   {ip}/32   scram-sha-256" for ip in DB_CLIENTS]
    lines += ["host    all   all   0.0.0.0/0      reject", "host    all   all   ::/0           reject"]
    return "\n".join(lines) + "\n"


def cmd_init(conf: dict, args: list[str]) -> int:
    if conf["SERVER"] == "212":
        os.makedirs(PG_DIR, mode=0o755, exist_ok=True)
        os.chmod(PG_DIR, 0o755)
        path = os.path.join(PG_DIR, "pg_hba.conf")
        with open(path, "w", encoding="utf-8") as f:
            f.write(pg_hba())
        os.chmod(path, 0o644)
        print(f"{path} ready (clients: {', '.join(DB_CLIENTS)})")
        return 0
    for d in DATA_DIRS:
        p = os.path.join(DATA_ROOT, d)
        os.makedirs(p, exist_ok=True)
        os.chown(p, CONTAINER_UID, CONTAINER_UID)
        os.chmod(p, 0o755)
    os.makedirs(TLS_DIR, mode=0o755, exist_ok=True)
    print(f"data dirs ready under {DATA_ROOT}")
    return 0


