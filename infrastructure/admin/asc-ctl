class Denied(Exception):
    pass


# --------------------------------------------------------------------------- helpers


def die(msg: str, code: int = 2) -> None:
    print(f"asc-ctl: {msg}", file=sys.stderr)
    sys.exit(code)


def load_conf(path: str = CONF_FILE) -> dict:
    conf = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    for k in ("SERVER", "LAN_IP", "ASC_USER", "REPO"):
        if not conf.get(k):
            die(f"{path}: missing {k}")
    if conf["SERVER"] not in ("201", "206", "210", "212"):
        die("SERVER must be 201, 206, 210 or 212")
    return conf


def audit(argv: list[str], result: str) -> None:
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} user={os.environ.get('SUDO_USER', '?')} "
                    f"argv={json.dumps(argv)} result={result}\n")
    except OSError:
        pass


def run(cmd: list[str], **kw) -> int:
    sys.stdout.flush()  # keep our headers in order with the child's output
    return subprocess.run(cmd, **kw).returncode


def out(cmd: list[str]) -> str:
    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout


def user_ids(conf: dict) -> tuple[int, int, str]:
    import pwd  # Linux only (kept local so the policy can be unit-tested anywhere)

    pw = pwd.getpwnam(conf["ASC_USER"])
    return pw.pw_uid, pw.pw_gid, pw.pw_dir


def under(path: str, prefix: str) -> bool:
    real = os.path.realpath(path)
    prefix = os.path.realpath(prefix)
    return real == prefix or real.startswith(prefix.rstrip("/") + "/")


def user_file(conf: dict, path: str) -> str:
    """A file the caller wants us to read: must be a regular file inside the asc home."""
    _, _, home = user_ids(conf)
    real = os.path.realpath(path)
    if not under(real, home) or not os.path.isfile(real):
        raise Denied(f"{path}: must be an existing file inside {home}")
    return real


def chown_to_user(conf: dict, path: str) -> None:
    uid, gid, _ = user_ids(conf)
    os.chown(path, uid, gid)


def repo(conf: dict) -> str:
    _, _, home = user_ids(conf)
    r = os.path.realpath(conf["REPO"])
    if not under(r, home):
        die("REPO must be inside the asc home")
    return r


# --------------------------------------------------------------------------- policy


def _as_list(v):
    if v is None:
        return []
    return v if isinstance(v, list) else [v]


def check_policy(cfg: dict, conf: dict) -> list[str]:
    """Return a list of violations (empty = allowed)."""
    v: list[str] = []
    gpu_host = conf["SERVER"] in ("201", "210")
    db_host = conf["SERVER"] == "212"
    ports_ok = {DB_HOST_PORT} if db_host else ALLOWED_PORTS
    render_gid = str(conf.get("RENDER_GID", ""))
    allowed_ips = {conf["LAN_IP"], "127.0.0.1"}
    if cfg.get("name") != "asc":
        v.append("project name must be 'asc'")
    for key in ("secrets", "configs"):
        if cfg.get(key):
            v.append(f"top-level {key} not allowed")
    top_vols = cfg.get("volumes") or {}
    for name, spec in top_vols.items():
        spec = spec or {}
        if spec.get("external"):
            v.append(f"volume {name}: external volumes not allowed")
        if not str(spec.get("name", f"asc_{name}")).startswith("asc_"):
            v.append(f"volume {name}: name must start with asc_")
        if spec.get("driver") not in (None, "local") or spec.get("driver_opts"):
            v.append(f"volume {name}: only plain local volumes")
    for name, spec in (cfg.get("networks") or {}).items():
        spec = spec or {}
        if spec.get("external"):
            v.append(f"network {name}: external networks not allowed")
        if not str(spec.get("name", "")).startswith("asc_net"):
            v.append(f"network {name}: name must start with asc_net")
        if spec.get("driver") not in (None, "bridge"):
            v.append(f"network {name}: only bridge networks")
    for svc, s in (cfg.get("services") or {}).items():
        p = f"service {svc}"
        if s.get("privileged"):
            v.append(f"{p}: privileged")
        if s.get("cap_add"):
            v.append(f"{p}: cap_add")
        for k in ("pid", "ipc", "uts", "userns_mode", "cgroup"):
            if str(s.get(k, "")).startswith("host"):
                v.append(f"{p}: {k}=host")
        if s.get("network_mode"):
            v.append(f"{p}: network_mode not allowed")
        for k in ("sysctls", "volumes_from", "runtime", "cgroup_parent", "device_cgroup_rules", "secrets", "configs",
                  "build", "isolation"):
            if s.get(k):
                v.append(f"{p}: {k} not allowed")
        for opt in _as_list(s.get("security_opt")):
            if "unconfined" in str(opt) or "disable" in str(opt):
                v.append(f"{p}: security_opt {opt}")
        if str(s.get("user", "")).split(":")[0] in ("0", "root"):
            v.append(f"{p}: user root")
        cname = s.get("container_name")
        if cname is not None and not str(cname).startswith("asc-"):
            v.append(f"{p}: container_name must start with asc-")
        image = str(s.get("image", ""))
        if CLOUDFLARED_IMAGE_RE.match(image):
            if svc != "tunnel" or s.get("container_name") != "asc-tunnel" or conf["SERVER"] != "210":
                v.append(f"{p}: cloudflared only as service 'tunnel' (asc-tunnel) on 210")
            if s.get("ports") or s.get("devices") or s.get("group_add"):
                v.append(f"{p}: the tunnel connector publishes no ports and gets no devices")
            if not s.get("read_only") or "ALL" not in [str(c) for c in _as_list(s.get("cap_drop"))]:
                v.append(f"{p}: tunnel must be read_only with cap_drop ALL")
        elif not IMAGE_RE.match(image):
            v.append(f"{p}: image {s.get('image')!r} not allowed")
        elif db_host and (svc != "postgres" or cname != "asc-postgres" or not POSTGRES_IMAGE_RE.match(image)):
            v.append(f"{p}: on 212 only the asc PostgreSQL (service postgres, asc-postgres) may run")
        for d in _as_list(s.get("devices")):
            src = d.get("source") if isinstance(d, dict) else str(d).split(":")[0]
            if not gpu_host or src != "/dev/dri/renderD128":
                v.append(f"{p}: device {src} not allowed")
        for g in _as_list(s.get("group_add")):
            if str(g) != render_gid:
                v.append(f"{p}: group_add {g} not allowed (only render gid {render_gid})")
        for port in _as_list(s.get("ports")):
            if isinstance(port, dict):
                hip, pub = str(port.get("host_ip", "")), str(port.get("published", ""))
            else:
                parts = str(port).split(":")
                hip, pub = (parts[0], parts[1]) if len(parts) == 3 else ("", parts[0])
            if hip not in allowed_ips:
                v.append(f"{p}: port must bind to {sorted(allowed_ips)} (got {hip or '0.0.0.0'})")
            if pub not in ports_ok:
                v.append(f"{p}: published port {pub} not allowed")
            if db_host and hip != conf["LAN_IP"]:
                v.append(f"{p}: on 212 the database binds only to {conf['LAN_IP']}")
        for vol in _as_list(s.get("volumes")):
            if not isinstance(vol, dict):
                v.append(f"{p}: unexpected volume syntax {vol!r}")
                continue
            t = vol.get("type")
            if t == "bind":
                # normpath collapses ".."; /opt/asc and /etc/asc/tls are root-owned, so the caller
                # cannot plant symlinks there
                src = posixpath.normpath(str(vol.get("source", "")))
                if not any(src == pre.rstrip("/") or src.startswith(pre.rstrip("/") + "/")
                           for pre in ALLOWED_BIND_PREFIXES):
                    v.append(f"{p}: bind mount {src} outside /opt/asc or /etc/asc/tls")
                if src.startswith("/etc/asc/tls") and not vol.get("read_only"):
                    v.append(f"{p}: {src} must be read-only")
                if src.startswith(TUNNEL_DIR) and (svc != "tunnel" or not vol.get("read_only")):
                    v.append(f"{p}: {src} only read-only in the tunnel service")
                if src.startswith(PG_DIR) and (svc != "postgres" or not vol.get("read_only")):
                    v.append(f"{p}: {src} only read-only in the postgres service")
            elif t == "volume":
                if vol.get("source") not in top_vols:
                    v.append(f"{p}: volume {vol.get('source')} not declared by the project")
            elif t != "tmpfs":
                v.append(f"{p}: volume type {t} not allowed")
        limits = ((s.get("deploy") or {}).get("resources") or {}).get("limits") or {}
        if not limits.get("cpus") or not limits.get("memory"):
            v.append(f"{p}: CPU and memory limits are mandatory")
    return v


def compose_cmd(conf: dict, resolved: str | None, profile) -> list[str]:
    """``profile``: bool (gpu, legacy callers) or a list of profile names (gpu, tunnel)."""
    base = [DOCKER, "compose", "-p", "asc"]
    if resolved:
        base += ["-f", resolved]
    else:
        base += ["-f", os.path.join(repo(conf), "infrastructure", "compose", f"server-{conf['SERVER']}.yml"),
                 "--env-file", ENV_FILE]
    profiles = (["gpu"] if profile else []) if isinstance(profile, bool) else list(profile)
    for name in profiles:
        base += ["--profile", name]
    return base


def resolve_and_check(conf: dict, profile: bool) -> str:
    if not os.path.isfile(ENV_FILE):
        raise Denied(f"{ENV_FILE} missing (run: asc-ctl env-install FILE)")
    raw = out(compose_cmd(conf, None, profile) + ["config", "--format", "json"])
    cfg = json.loads(raw)
    violations = check_policy(cfg, conf)
    if violations:
        raise Denied("policy violations:\n  - " + "\n  - ".join(violations))
    os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
    fd, path = tempfile.mkstemp(prefix="resolved-", suffix=".json", dir=RUN_DIR)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f)
    return path


# --------------------------------------------------------------------------- commands


def cmd_compose(conf: dict, args: list[str]) -> int:
    if not args or args[0] not in COMPOSE_SUBCOMMANDS:
        raise Denied(f"compose subcommand must be one of {sorted(COMPOSE_SUBCOMMANDS)}")
    sub, rest = args[0], args[1:]
    profile: list[str] = []
    tail = "200"
    services = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--gpu":
            profile.append("gpu")
        elif a == "--tunnel":
            if conf["SERVER"] != "210":
                raise Denied("the tunnel profile exists only on 210")
            profile.append("tunnel")
        elif a == "--tail" and i + 1 < len(rest) and rest[i + 1].isdigit():
            tail = rest[i + 1]
            i += 1
        elif NAME_RE.match(a):
            services.append(a)
        else:
            raise Denied(f"argument {a!r} not allowed")
        i += 1
    path = resolve_and_check(conf, profile)
    try:
        base = compose_cmd(conf, path, profile)
        if sub == "config":
            print(json.dumps({k: v for k, v in json.load(open(path)).items() if k != "services"}, indent=1))
            print("services:", ", ".join(json.load(open(path))["services"]))
            print("policy: OK")
            return 0
        extra = {
            "up": ["up", "-d", "--remove-orphans", "--no-build"],
            "down": ["down", "--remove-orphans"],  # never -v: data volumes are kept
            "logs": ["logs", "--no-color", "--tail", tail],
            "pull": ["pull", "--ignore-pull-failures"],
        }.get(sub, [sub])
        return run(base + extra + services)
    finally:
        os.unlink(path)


def cmd_exec(conf: dict, args: list[str]) -> int:
    if len(args) < 3 or args[1] != "--":
        raise Denied("usage: asc-ctl exec <asc-container> -- <command...>")
    name = args[0]
    if not name.startswith("asc-") or not NAME_RE.match(name):
        raise Denied("only asc-* containers")
    label = out([DOCKER, "inspect", "-f", '{{index .Config.Labels "com.docker.compose.project"}}', name]).strip()
    if label != "asc":
        raise Denied(f"{name} does not belong to project asc")
    return run([DOCKER, "exec", name] + args[2:])


IMAGE_KINDS = {"app": "", "vision": "-vision", "commercial": "-commercial"}
DOCKERFILES = {"app": "app.Dockerfile", "vision": "vision-openvino.Dockerfile", "commercial": "commercial.Dockerfile"}


def image_ref(kind: str, tag: str) -> str:
    if kind not in IMAGE_KINDS or not TAG_RE.match(tag):
        raise Denied("image must be app|vision|commercial and tag [A-Za-z0-9._-]")
    return f"ai-stream-clipper{IMAGE_KINDS[kind]}:{tag}"


def cmd_build(conf: dict, args: list[str]) -> int:
    if len(args) != 2:
        raise Denied("usage: asc-ctl build app|vision|commercial TAG")
    ref = image_ref(*args)
    r = repo(conf)
    dockerfile = os.path.join(r, "infrastructure", "docker", DOCKERFILES[args[0]])
    cmd = [DOCKER, "build", "--pull", "-f", dockerfile, "-t", ref,
           "--label", "com.asc.project=ai-stream-clipper"]
    ov = conf.get("OPENVINO_IMAGE", "openvino/ubuntu24_runtime:2026.2.0")
    if not re.match(r"^openvino/[a-z0-9_]+:[0-9.]+$", ov):
        raise Denied("OPENVINO_IMAGE in asc-ctl.conf is not an openvino/* image")
    if args[0] == "vision":
        cmd += ["--build-arg", f"OPENVINO_IMAGE={ov}"]
    return run(cmd + [r])


def cmd_images(conf: dict, args: list[str]) -> int:
    return run([DOCKER, "images", "--filter", "reference=ai-stream-clipper*", "--filter",
                "reference=postgres:16*", "--format", "{{.Repository}}:{{.Tag}}\t{{.ID}}\t{{.Size}}\t{{.CreatedSince}}"])


def cmd_image_save(conf: dict, args: list[str]) -> int:
    if len(args) != 2:
        raise Denied("usage: asc-ctl image-save app|vision TAG")
    ref = image_ref(*args)
    _, _, home = user_ids(conf)
    d = os.path.join(home, "images")
    os.makedirs(d, exist_ok=True)
    chown_to_user(conf, d)
    dest = os.path.join(d, ref.replace(":", "_") + ".tar.gz")
    with open(dest, "wb") as f:
        p1 = subprocess.Popen([DOCKER, "save", ref], stdout=subprocess.PIPE)
        p2 = subprocess.Popen(["gzip", "-1"], stdin=p1.stdout, stdout=f)
        p1.stdout.close()
        rc = p2.wait() or p1.wait()
    chown_to_user(conf, dest)
    print(dest)
    return rc


def image_tags_in_archive(path: str) -> list[str]:
    tags: list[str] = []
    with tarfile.open(path, "r:*") as t:
        for m in t:
            if m.name in ("manifest.json", "./manifest.json"):
                for entry in json.load(t.extractfile(m)):
                    tags += entry.get("RepoTags") or []
            elif m.name in ("index.json", "./index.json"):
                for man in json.load(t.extractfile(m)).get("manifests", []):
                    ann = man.get("annotations") or {}
                    name = ann.get("io.containerd.image.name")
                    if name:
                        tags.append(name)
    return sorted(set(tags))


def cmd_image_load(conf: dict, args: list[str]) -> int:
    if len(args) != 1:
        raise Denied("usage: asc-ctl image-load FILE (inside the asc home)")
    path = user_file(conf, args[0])
    tags = image_tags_in_archive(path)
    if not tags:
        raise Denied("archive has no tagged image")
    bad = [t for t in tags if not OWN_IMAGE_RE.match(t)]
    if bad:
        raise Denied(f"archive would load foreign image tags: {bad}")
    print("loading", ", ".join(tags))
    return run([DOCKER, "load", "-i", path])


def cmd_image_rm(conf: dict, args: list[str]) -> int:
    if len(args) != 2:
        raise Denied("usage: asc-ctl image-rm app|vision TAG")
    ref = image_ref(*args)
    used = out([DOCKER, "ps", "-a", "--filter", f"ancestor={ref}", "-q"]).strip()
    if used:
        raise Denied(f"{ref} is used by a container")
    return run([DOCKER, "image", "rm", ref])


def cmd_env_install(conf: dict, args: list[str]) -> int:
    if len(args) != 1:
        raise Denied("usage: asc-ctl env-install FILE")
    path = user_file(conf, args[0])
    lines = []
    for n, line in enumerate(open(path, encoding="utf-8").read().splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if "=" not in line:
            raise Denied(f"line {n}: expected KEY=VALUE")
        k, val = line.split("=", 1)
        k, val = k.strip(), val.strip()
        if k not in ENV_KEYS:
            raise Denied(f"line {n}: key {k} not allowed")
        if not (LOOSE_VALUE_RE if k in LOOSE_VALUE_KEYS else ENV_VALUE_RE).match(val):
            raise Denied(f"line {n}: value of {k} has forbidden characters")
        if k == "ASC_RENDER_GID" and val != str(conf.get("RENDER_GID", "")):
            raise Denied(f"ASC_RENDER_GID must be {conf.get('RENDER_GID')}")
        if k == "ASC_IMAGE_TAG" and not TAG_RE.match(val):
            raise Denied("bad ASC_IMAGE_TAG")
        if k == "ASC_DB_HOST" and val not in ("postgres", "192.168.1.212"):
            raise Denied("ASC_DB_HOST must be postgres or 192.168.1.212")
        if k == "ASC_DB_PORT" and val not in ("5432", DB_HOST_PORT):
            raise Denied(f"ASC_DB_PORT must be 5432 or {DB_HOST_PORT}")
        lines.append(f"{k}={val}")
    os.makedirs("/etc/asc", exist_ok=True)
    tmp = ENV_FILE + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o600)
    if os.path.exists(ENV_FILE):
        shutil.copy2(ENV_FILE, ENV_FILE + ".prev")
    os.replace(tmp, ENV_FILE)
    print(f"installed {len(lines)} variables into {ENV_FILE}")
    return 0


