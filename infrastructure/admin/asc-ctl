def cmd_backup_db(conf: dict, args: list[str]) -> int:
    if conf["SERVER"] not in ("210", "212"):
        raise Denied("the database lives on 210 or 212")
    _, _, home = user_ids(conf)
    d = os.path.join(home, "backups")
    os.makedirs(d, exist_ok=True)
    chown_to_user(conf, d)
    dest = os.path.join(d, f"asc-{datetime.datetime.now().strftime('%Y%m%d-%H%M%S')}.sql.gz")
    with open(dest, "wb") as f:
        p1 = subprocess.Popen([DOCKER, "exec", "asc-postgres", "pg_dump", "-U", "asc", "-d", "asc", "--no-owner"],
                              stdout=subprocess.PIPE)
