def cmd_tunnel_token_install(conf: dict, args: list[str]) -> int:
    """Read the Cloudflare Tunnel token from STDIN (paste + Ctrl-D, or `< file`); never from argv."""
    if conf["SERVER"] != "210":
        raise Denied("tunnel token only on 210")
    if args:
        raise Denied("the token is read from stdin, never from arguments (they end up in logs and ps)")
    if sys.stdin.isatty():
        import getpass

        token = getpass.getpass("Cole o token do túnel (não aparece na tela) e Enter: ")
    else:
        token = sys.stdin.read(8192)
    token = token.strip()
    if not TUNNEL_TOKEN_RE.match(token):
        raise Denied("this does not look like a Cloudflare Tunnel token")
    os.makedirs(TUNNEL_DIR, mode=0o755, exist_ok=True)
    os.chmod(TUNNEL_DIR, 0o755)
    tmp = TUNNEL_TOKEN + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
    with os.fdopen(fd, "w") as f:
        f.write(token)
    os.chown(tmp, TUNNEL_UID, TUNNEL_UID)
    os.replace(tmp, TUNNEL_TOKEN)
    import hashlib

    print(f"token instalado em {TUNNEL_TOKEN} (0400, uid {TUNNEL_UID}); sha256 {hashlib.sha256(token.encode()).hexdigest()[:12]}…")
    return 0


def cmd_tunnel_token_remove(conf: dict, args: list[str]) -> int:
    if os.path.exists(TUNNEL_TOKEN):
        os.unlink(TUNNEL_TOKEN)
    print("token removido")
    return 0


