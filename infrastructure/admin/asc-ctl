def _bench_manifest(manifest: dict) -> list[PurePosixPath]:
    videos = manifest.get("videos")
    if not isinstance(videos, list) or not 1 <= len(videos) <= 32:
        raise Denied("manifest must contain between 1 and 32 videos")
    paths = set()
    for case in videos:
        if not isinstance(case, dict) or bool(case.get("video")) == bool(case.get("segments")):
            raise Denied("each manifest case needs exactly one video or segment list")
        if case.get("video"):
            path = _bench_media_path(case["video"])
            paths.add(path)
            case["video"] = path.as_posix()
            continue
        segments = case["segments"]
        if not isinstance(segments, list) or len(segments) > 64:
            raise Denied("invalid manifest segment list")
        for segment in segments:
            if not isinstance(segment, dict):
                raise Denied("invalid manifest segment")
            path = _bench_media_path(segment.get("file"))
            if path.suffix.lower() != ".ts":
                raise Denied("archived segments must be .ts")
            paths.add(path)
            segment["file"] = path.as_posix()
    if len(paths) > 64:
        raise Denied("manifest exceeds 64 distinct media files")
    return sorted(paths)


def _bench_package(source: int, dest: Path, uid: int, deadline: float) -> None:
