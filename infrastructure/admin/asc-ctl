def main(argv: list[str]) -> int:
    os.environ["PATH"] = SAFE_PATH  # never trust the caller's PATH when running as root
    if os.geteuid() != 0:
        die("run through sudo")
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        print("commands:", ", ".join(sorted(COMMANDS)), "| version")
        return 0
    if argv[0] == "version":
        print(VERSION)
        return 0
    conf = load_conf()
    fn = COMMANDS.get(argv[0])
    if fn is None:
        die(f"unknown command {argv[0]}")
    try:
        rc = fn(conf, argv[1:])
    except Denied as exc:
        audit(argv, "denied")
        die(f"denied: {exc}", 3)
    except subprocess.CalledProcessError as exc:
        audit(argv, f"error {exc.returncode}")
        die(f"command failed ({exc.returncode})", 1)
    audit(argv, f"rc={rc}")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
