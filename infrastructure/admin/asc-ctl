            for entry in children:
                name = entry.name
                if name == "__pycache__":
                    continue
                entries += 1
                if entries > 512 or time.monotonic() >= deadline:
                    raise Denied("PR #31 package exceeds replay limits")
                child = output / name
                if entry.is_dir(follow_symlinks=False):
                    with _bench_open_dir(fd, (name,), input_uid=uid) as sub:
                        snapshot(sub, child, depth + 1)
                else:
                    with _bench_regular(fd, name, uid, remaining) as (f, _):
                        data = f.read(remaining + 1)
                    if len(data) > remaining:
                        raise Denied("PR #31 package exceeds replay limits")
                    remaining -= len(data)
                    child.write_bytes(data)
                    child.chmod(0o644)
                    hashes[child.relative_to(dest).as_posix()] = hashlib.sha256(data).digest()

    with _bench_open_dir(source, options[0], input_uid=uid) as package:
        snapshot(package, dest)
    digest = hashlib.sha256()
    for name, signature in sorted(hashes.items()):
        digest.update(name.encode("utf-8") + b"\x00" + signature)
    if digest.hexdigest() != PR31_PACKAGE_SHA:
        raise Denied(f"backend must match the reviewed PR #31 commit {PR31_COMMIT}")


def _bench_stage(source: int, staging: Path, uid: int, deadline: float) -> None:
    editorial = _bench_json(source, ("editorial.json", "settings.json", "editorial-75.json", "settings-75.json"), uid)
    _bench_score(editorial)
    manifest = _bench_json(source, ("annotations.json", "manifest.json"), uid)
    files = _bench_manifest(manifest)
    backend = staging / "backend"
    backend.mkdir()
    backend.chmod(0o755)
    _bench_package(source, backend / "clipper", uid, deadline)
    inputs = staging / "inputs"
    inputs.mkdir()
    inputs.chmod(0o755)
    for name, data in (("editorial.json", editorial), ("annotations.json", manifest)):
        (inputs / name).write_text(json.dumps(data, allow_nan=False), encoding="utf-8")
        (inputs / name).chmod(0o644)
    remaining = 4 * GIB
    t0 = time.monotonic()
    nested_media = not _bench_present(source, "media")
    for entry in files:
        target = inputs
        for component in entry.parts[:-1]:
            target /= component
            target.mkdir(exist_ok=True)
            target.chmod(0o755)
        target /= entry.name
        source_parts = entry.parts[:-1]
        if nested_media and entry.parts[0] == "media":
            source_parts = ("bench", *source_parts)
        with _bench_open_dir(source, source_parts, input_uid=uid) as parent:
            with _bench_regular(parent, entry.name, uid, min(remaining, 2 * GIB)) as (f, size):
                before = os.fstat(f.fileno())
                with target.open("xb") as dst:
                    left = size
                    while left:
                        data = f.read(min(left, MIB))
                        if not data or time.monotonic() >= deadline:
                            raise Denied("media changed or staging exceeded the replay deadline")
                        dst.write(data)
                        remaining -= len(data)
                        left -= len(data)
                        delay = (4 * GIB - remaining) / (32 * MIB) - (time.monotonic() - t0)
                        if delay > 0:
                            time.sleep(delay)
                    if f.read(1) or os.fstat(f.fileno()).st_mtime_ns != before.st_mtime_ns:
                        raise Denied("media changed during staging")
        target.chmod(0o644)


def _bench_gpu(conf: dict) -> tuple[str, set[int]]:
    dev = PR31_DEVICE.lstat()
    gid = conf.get("RENDER_GID", "")
    if (not stat.S_ISCHR(dev.st_mode) or not gid.isdecimal() or int(gid) != dev.st_gid or
            int(gid) == 0 or (dev.st_mode & 0o060) != 0o060):
        raise Denied("render device or group permissions do not match the 201 configuration")
    sys_device = Path("/sys/dev/char") / f"{os.major(dev.st_rdev)}:{os.minor(dev.st_rdev)}" / "device"
    if (sys_device / "vendor").read_text().strip() != "0x8086":
        raise Denied("the configured render device is not Intel")
    nodes = {dev.st_rdev}
    for node in (sys_device / "drm").iterdir():
        if re.fullmatch(r"(?:card|renderD)[0-9]+", node.name):
            peer = (PR31_DEVICE.parent / node.name).lstat()
            if stat.S_ISCHR(peer.st_mode):
                nodes.add(peer.st_rdev)
    return gid, nodes


def _bench_gpu_clients(nodes: set[int]) -> dict[int, str]:
    """Match device numbers, including GPU device nodes created in Docker mount namespaces."""
    clients = {}
    for proc in Path("/proc").iterdir():
        if not proc.name.isdecimal():
            continue
        try:
            for fd in (proc / "fd").iterdir():
                try:
                    st = fd.stat()
                except FileNotFoundError:
                    continue
                if stat.S_ISCHR(st.st_mode) and st.st_rdev in nodes:
                    clients[int(proc.name)] = os.readlink(proc / "ns/pid")
                    break
        except (FileNotFoundError, ProcessLookupError):
            continue
    return clients


def _bench_capacity(*, starting: bool) -> None:
    cpus = len(os.sched_getaffinity(0))
    meminfo = Path("/proc/meminfo").read_text()
    available = re.search(r"^MemAvailable:\s+(\d+)\s+kB$", meminfo, re.M)
    if cpus < 6 or not available or int(available[1]) * 1024 < (16 if starting else 4) * GIB:
        raise Denied("insufficient host CPU or available memory for the benchmark reserve")
    if os.getloadavg()[0] > cpus - (4 if starting else 0):
        raise Denied("host load no longer leaves enough capacity for other services")


def _bench_host_address() -> None:
    result = subprocess.run(["/usr/sbin/ip", "-j", "-4", "address", "show"],
                            env=BENCH_DOCKER_ENV, capture_output=True, text=True, timeout=5, check=True)
    if not any(row.get("local") == "192.168.1.201" for link in json.loads(result.stdout)
               for row in link.get("addr_info", [])):
        raise Denied("the 201 LAN address is not assigned to this host")


BENCH_PEER = '{{.Id}} {{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.RestartCount}}'


def _bench_peers(ids: list[str]) -> dict[str, str]:
    if not all(CONTAINER_ID.fullmatch(cid) for cid in ids):
        raise Denied("unexpected container ID in monitor")
    if not ids:
        return {}
    lines = _bench_docker("inspect", "--type", "container", "-f", BENCH_PEER, *ids).splitlines()
    states = {}
    for line in lines:
        cid, status, health, restarts = line.split()
        states[cid] = f"{status} {health} {restarts}"
    if states.keys() != set(ids):
        raise Denied("Docker did not report every monitored peer")
    return states


def _bench_no_contention(nodes: set[int], namespace: str | None) -> int:
    clients = _bench_gpu_clients(nodes)
    if any(ns != namespace for ns in clients.values()):
        raise Denied("the shared GPU has an external client")
    return len(clients)


def _bench_image() -> tuple[str, str]:
    info = json.loads(_bench_docker("info", "--format", "{{json .}}"))
    if (info.get("OSType") != "linux" or info.get("CgroupDriver") not in ("systemd", "cgroupfs") or
            not all(info.get(k) is True for k in ("MemoryLimit", "SwapLimit", "CpuCfsQuota", "PidsLimit")) or
            not any(s.startswith("name=seccomp") and "unconfined" not in s for s in info.get("SecurityOptions") or [])):
        raise Denied("local Docker must enforce CPU, memory, swap, PID and seccomp limits")
    if _bench_docker("ps", "-aq", "--filter", f"label={PR31_LABEL}"):
        raise Denied("a PR #31 sandbox already exists; inspect it before another run")
    fmt = ('{{.Id}} {{.Image}} {{.Config.Image}} {{.State.Status}} {{index .Config.Labels "com.docker.compose.project"}} '
           '{{index .Config.Labels "com.docker.compose.service"}}')
    worker, image, tag, status, project, service = _bench_docker("inspect", "--type", "container", "-f", fmt,
                                                                "asc-worker-vision").split()
    if (not re.fullmatch(r"sha256:[a-f0-9]{64}", image) or
            not re.fullmatch(r"(?:docker\.io/library/)?ai-stream-clipper-vision:[A-Za-z0-9._-]{1,40}", tag) or
            not CONTAINER_ID.fullmatch(worker) or (status, project, service) != ("running", "asc", "worker-vision")):
        raise Denied("unexpected image, state or labels on the existing vision worker")
    volumes = json.loads(_bench_docker("image", "inspect", "-f", "{{json .Config.Volumes}}", image))
    if volumes:
        raise Denied("vision image declares implicit volumes outside the benchmark mount list")
    return image, worker


def _bench_create(staging: Path, image: str, gid: str, name: str, seconds: int, *, check: bool = False) -> list[str]:
    if not 1 <= seconds <= PR31_TIMEOUT - 5:
        raise Denied("benchmark deadline exhausted")
    args = ["create", "--pull", "never", "--name", name, "--label", PR31_LABEL, "--restart", "no", "--init",
            "--user", f"{CONTAINER_UID}:{CONTAINER_UID}", "--cap-drop", "ALL",
            "--security-opt", "no-new-privileges:true", "--network", "none", "--read-only",
            "--no-healthcheck", "--ipc", "private", "--cgroupns", "private",
            "--cpus", "4", "--cpu-shares", "64", "--memory", "12g", "--memory-swap", "12g", "--pids-limit", "256",
            "--log-driver", "local", "--log-opt", "max-size=2m", "--log-opt", "max-file=1",
            "--tmpfs", "/tmp:rw,nosuid,nodev,noexec,size=6g,mode=1777",
            "--workdir", "/tmp",
            "-e", f"PYTHONPATH={PR31_PYTHONPATH}", "-e", "HOME=/tmp", "-e", "TMPDIR=/tmp",
            "-e", "HF_HUB_OFFLINE=1", "-e", "HF_HOME=/models/hf", "-e", "HF_HUB_CACHE=/pr31/audio/hub"]
    mounts = [(staging / "backend", PR31_PYTHONPATH), (staging / "inputs", "/inputs"),
              (PR31_MODELS, "/models"), (PR31_AUDIO, "/pr31/audio")]
    if not check:
        args += ["--group-add", gid, "--device", f"{PR31_DEVICE}:{PR31_DEVICE}:rw"]
        mounts.append((staging / "result", "/result"))
    for host, dest in mounts:
        mount = f"type=bind,source={host},target={dest},bind-propagation=rprivate,bind-recursive=disabled"
        args += ["--mount", mount + (",readonly" if dest != "/result" else "")]
    return args + ["--entrypoint", "/usr/bin/timeout", image, "--kill-after=5s", f"{seconds}s",
                   "/opt/asc/bin/python3", "-s", "-B", "-u", "-c", PR31_ENTRY] + (["--check"] if check else [])


def _bench_watch(cid: str, peers: dict[str, str], nodes: set[int] | None, deadline: float, record: dict) -> int:
    while time.monotonic() < deadline:
        status, pid, rc = _bench_docker("inspect", "--type", "container", "-f",
                                        "{{.State.Status}} {{.State.Pid}} {{.State.ExitCode}}", cid).split()
        if _bench_peers(list(peers)) != peers:
            raise Denied("a peer container changed state, health or restart count")
        _bench_capacity(starting=False)
        if shutil.disk_usage(PR31_STATE).free < 4 * GIB:
            raise Denied("free staging disk space fell below the host reserve")
        if nodes is not None:
            namespace = None
            if pid.isdecimal() and int(pid):
                try:
                    namespace = os.readlink(f"/proc/{pid}/ns/pid")
                except FileNotFoundError:
                    pass  # the replay may have exited between Docker inspect and this read
            count = _bench_no_contention(nodes, namespace)
            record["peak_gpu_clients"] = max(record.get("peak_gpu_clients", 0), count)
        record["samples"] += 1
        if status in ("exited", "dead"):
            return int(rc)
        if status != "running":
            raise Denied("benchmark container is no longer running")
        time.sleep(min(2, max(0, deadline - time.monotonic())))
    raise Denied("benchmark reached its time limit")


def _bench_publish(out_fd: int, name: str, data: dict, uid: int, gid: int) -> None:
    raw = json.dumps(data, ensure_ascii=True, indent=2, allow_nan=False) + "\n"
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=out_fd)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(raw)
        f.flush()
        os.fchown(f.fileno(), uid, gid)


def cmd_bench_pr31(conf: dict, args: list[str]) -> int:
    if conf["SERVER"] != "201" or conf["LAN_IP"] != "192.168.1.201":
        raise Denied("bench-pr31 is restricted to the 201")
    if args not in ([], ["--check"]):
        raise Denied("usage: asc-ctl bench-pr31 [--check] (fixed inputs, no path arguments)")
    import fcntl
    import signal

    uid, gid, home = user_ids(conf)
    if conf["ASC_USER"] != "asc" or home != "/home/asc" or not uid:
        raise Denied("the configured asc account does not match /home/asc")
    deadline = time.monotonic() + (PR31_CHECK_TIMEOUT if args else PR31_TIMEOUT)
    try:
        _bench_trusted_dir(PR31_DOCKER_CONFIG, create=True)
        if any(PR31_DOCKER_CONFIG.iterdir()):
            raise Denied("benchmark Docker CLI config directory must be empty")
        with (PR31_STATE / "lock").open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise Denied("another PR #31 benchmark is running") from None
            return _bench_run(uid, gid, conf, args == ["--check"], deadline, signal)
    except (OSError, ValueError, KeyError, RecursionError, subprocess.SubprocessError) as exc:
        raise Denied(f"benchmark paths, permissions or telemetry failed validation ({type(exc).__name__})") from exc


def _bench_run(uid: int, gid: int, conf: dict, check: bool, deadline: float, signal) -> int:
    _bench_host_address()
    _bench_capacity(starting=True)
    _bench_trusted_dir(PR31_MODELS)
    render_gid, gpu_nodes = _bench_gpu(conf)
    # A CPU-only check has no GPU device. Keep the device and permission preflight for both modes.
    nodes = None if check else gpu_nodes
    if nodes is not None:
        _bench_no_contention(nodes, None)
    image, worker = _bench_image()
    _bench_audio(deadline)
    if shutil.disk_usage(PR31_STATE).free < 8 * GIB:
        raise Denied("benchmark staging needs 8 GiB free including its disk reserve")
    with (_bench_open_dir(None, PR31_ROOT.parts[1:], input_uid=uid) as source,
          _bench_open_dir(source, ("out",), input_uid=uid) as out_fd):
        st, fs = os.fstat(out_fd), os.fstatvfs(out_fd)
        if st.st_uid != uid or (st.st_mode & 0o300) != 0o300 or fs.f_bavail * fs.f_frsize < 512 * MIB:
            raise Denied("out must be owned and writable by asc with at least 512 MiB free")
        with tempfile.TemporaryDirectory(prefix="run-", dir=PR31_STATE) as tmp:
            staging = Path(tmp)
            _bench_stage(source, staging, uid, deadline)
            _bench_capacity(starting=True)
            peers = _bench_peers(_bench_docker("ps", "--no-trunc", "-q").splitlines())
            if worker not in peers or any(not s.startswith(("running healthy ", "running none ")) for s in peers.values()):
                raise Denied("the vision worker disappeared or a running peer is not healthy")
            if nodes is not None:
                _bench_no_contention(nodes, None)
            result_dir = staging / "result"
            if not check:
                result_dir.mkdir(mode=0o700)
                os.chown(result_dir, CONTAINER_UID, CONTAINER_UID)
                os.chmod(result_dir, 0o700)
            token = uuid4().hex
            name = f"asc-bench-pr31-{token}"
            record = {"commit": PR31_COMMIT, "image_id": image, "container": name, "samples": 0, "result": "aborted"}
            cid = None
            rc = 1
            previous = signal.signal(signal.SIGTERM, signal.default_int_handler)
            try:
                remaining = min(PR31_TIMEOUT, int(deadline - time.monotonic()))
                created = _bench_docker(*_bench_create(staging, image, render_gid, name, remaining - 15, check=check))
                if not CONTAINER_ID.fullmatch(created):
                    raise Denied("unexpected sandbox ID from Docker")
                cid = created
                record["container_id"] = cid
                if time.monotonic() >= deadline - 10 or _bench_peers(list(peers)) != peers:
                    raise Denied("deadline or peer state changed before start")
                if nodes is not None:
                    _bench_no_contention(nodes, None)
                _bench_docker("start", cid)
                code = _bench_watch(cid, peers, nodes, deadline, record)
                record["exit_code"] = code
                if not check:
                    with _bench_open_dir(None, result_dir.parts[1:]) as result_fd:
                        if _bench_present(result_fd, "comparison.json"):
                            data = _bench_json(result_fd, ("comparison.json",), CONTAINER_UID, 16 * MIB)
                            settings = data.get("settings")
                            if not isinstance(settings, dict) or data.get("settings_source") != "export":
                                raise Denied("benchmark report did not use the settings export")
                            _bench_score(settings)
                            _bench_publish(out_fd, f"{name}.json", data, uid, gid)
                        elif code == 0:
                            raise Denied("replay ended without a report")
                rc = 0 if code == 0 else 1
                record["result"] = "completed" if rc == 0 else "replay failed"
            except (Denied, OSError, ValueError, RecursionError, KeyboardInterrupt) as exc:
                record["reason"] = str(exc) if isinstance(exc, Denied) else type(exc).__name__
                print(f"PR #31 benchmark stopped: {record['reason']}", file=sys.stderr)
            finally:
                # Shield cleanup from a second signal, and address only the ID returned by our create.
                sigint = signal.signal(signal.SIGINT, signal.SIG_IGN)
                signal.signal(signal.SIGTERM, signal.SIG_IGN)
                try:
                    if cid:
                        if rc and "exit_code" in record:
                            try:
                                record["log_tail"] = _bench_docker("logs", "--tail", "40", cid, timeout=3)[-8000:]
                            except Denied:
                                pass
                        try:
                            _bench_docker("rm", "-f", "-v", cid, timeout=10)
                        except Denied:
                            record["cleanup"] = "unverified; check sandbox ID"
                            print(f"PR #31 sandbox cleanup unverified: {cid}", file=sys.stderr)
                            rc = 1
                    if not check:
                        _bench_publish(out_fd, f"{name}.status.json", record, uid, gid)
                finally:
                    signal.signal(signal.SIGTERM, previous)
                    signal.signal(signal.SIGINT, sigint)
            if check:
                if rc == 0:
                    print("PR #31 offline audio and input preflight passed in the local vision image")
                elif "exit_code" in record:
                    print(f"PR #31 preflight exited {record['exit_code']}: {record.get('log_tail', '')}", file=sys.stderr)
            else:
                print(f"status: {PR31_ROOT}/out/{name}.status.json")
            return rc


