# AI Stream Clipper - per-server configuration. Fill in, then install with:
#   sudo asc-ctl env-install ~/asc.env       (validated, stored as /etc/asc/asc.env root 600)
# Only the keys below are accepted by asc-ctl. Host paths and ports are fixed in the compose
# files (/opt/asc, /etc/asc/tls, 8780/8781 on the LAN IP) and cannot be changed from here.
# Generate secrets with ./infrastructure/scripts/gen-secrets.sh. NEVER commit real values.

# --- all servers ---------------------------------------------------------------
ASC_IMAGE_TAG=0.4.4
# shared HMAC secret for API <-> workers <-> segment servers (same on 201/206/210)
ASC_INTERNAL_SECRET=

# --- server 210 (API + database) ---------------------------------------------------
ASC_JWT_SECRET=
ASC_DB_PASSWORD=
# postgres = bundled asc-postgres container; 192.168.1.212 = future database server
ASC_DB_HOST=postgres
# first admin (only used when the users table is empty)
ASC_ADMIN_EMAIL=
ASC_ADMIN_PASSWORD=
ASC_STORAGE_MAX_GB=300
ASC_METRICS_TOKEN=

# --- GPU hosts (201, 210) --------------------------------------------------------------
ASC_RENDER_GID=993
ASC_VISION_PROVIDER=openvino_vlm
ASC_AI_MODELS=qwen3-vl-2b-int4,qwen3-1.7b-int4
ASC_AI_ALLOW_CPU_FALLBACK=true

# --- server 206 --------------------------------------------------------------------------
ASC_WHISPER_MODEL=small
ASC_WHISPER_CPU_THREADS=4
ASC_CONCURRENCY_AUDIO=2
ASC_MAX_CONCURRENT_CAPTURES=3
ASC_BUFFER_SECONDS=1800
ASC_MAX_SESSION_HOURS=12
ASC_MAX_CAPTURE_DISK_GB=80
ASC_ALLOW_FILE_SOURCES=false
