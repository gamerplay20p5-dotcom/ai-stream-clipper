# AI Stream Clipper - environment template. Copy to .env.210 / .env.206 / .env.201 (or .env
# for the local stack) and fill in. NEVER commit real values.
# Generate secrets with: ./infrastructure/scripts/gen-secrets.sh

# --- all servers ---------------------------------------------------------------
ASC_IMAGE_TAG=0.1.0
# shared HMAC secret for API <-> workers <-> segment servers (same on 201/206/210)
ASC_INTERNAL_SECRET=
# private LAN IP this host binds published ports to (210: API 8780, 206: segments 8781)
ASC_BIND_IP=192.168.1.210

# --- server 210 (API + database) ---------------------------------------------------
ASC_JWT_SECRET=
ASC_DB_PASSWORD=
# point to the future DB server 212 by overriding the host (postgres = bundled container)
ASC_DB_HOST=postgres
# first admin (only used when the users table is empty); change the password after login
ASC_ADMIN_EMAIL=
ASC_ADMIN_PASSWORD=
# set true when served through HTTPS (e.g. existing Caddy reverse proxy)
ASC_COOKIE_SECURE=false
ASC_STORAGE_MAX_GB=300
ASC_METRICS_TOKEN=
# future Authentik / OIDC integration (not active yet)
ASC_OIDC_ISSUER=
ASC_OIDC_CLIENT_ID=

# --- GPU hosts (201, 210 with --gpu) --------------------------------------------------
# gid of the "render" group on the host: getent group render
ASC_RENDER_GID=
ASC_OPENVINO_IMAGE=openvino/ubuntu24_runtime:2026.2.0
# heuristic (validated) | openvino_vlm (experimental, needs an exported model in ASC_MODELS_DIR/vlm)
ASC_VISION_PROVIDER=heuristic
ASC_MODELS_DIR=/opt/asc/models

# --- workers on 206 / 201 ----------------------------------------------------------------
ASC_API_URL=http://192.168.1.210:8780
ASC_WHISPER_MODEL=small
ASC_WHISPER_CPU_THREADS=4
ASC_CONCURRENCY_AUDIO=2
ASC_MAX_CONCURRENT_CAPTURES=3
ASC_BUFFER_SECONDS=1800
ASC_MAX_SESSION_HOURS=12
ASC_MAX_CAPTURE_DISK_GB=80
ASC_ALLOW_FILE_SOURCES=false
