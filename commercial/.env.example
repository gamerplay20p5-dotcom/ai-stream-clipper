# Commercial site — copy to .env (ignored by git) or set these in the service environment.
# Never commit real keys.

COMMERCIAL_PORT=8790
COMMERCIAL_HOST=127.0.0.1
# Public origin used for Open Graph URLs and the Stripe return URLs (required for checkout)
COMMERCIAL_ORIGIN=https://example.com
# COMMERCIAL_DB=data/waitlist.sqlite
# COMMERCIAL_TRUST_PROXY=

# Stripe — checkout stays off unless the secret key, webhook secret and origin are all set.
# Start with test-mode keys (sk_test_..., whsec_... from the test-mode webhook endpoint).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: no-code customer portal login link (https://billing.stripe.com/p/login/...)
STRIPE_PORTAL_LOGIN_URL=
# Optional: true only after Stripe Tax is configured in the dashboard
STRIPE_AUTOMATIC_TAX=false
