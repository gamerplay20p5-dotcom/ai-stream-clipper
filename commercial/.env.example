# Commercial site — copy to .env (ignored by git) or set these in the service environment.
# Never commit real keys.

COMMERCIAL_PORT=8790
COMMERCIAL_HOST=127.0.0.1
# Public origin of this site (Open Graph URLs, InfinitePay return and webhook URLs)
COMMERCIAL_ORIGIN=https://example.com

# Link to the main platform (required for any checkout): accounts, access and quotas live there.
# The dashboard (account area): "Subscribe" opens <ASC_APP_URL>/conta, checkouts return there
ASC_APP_URL=https://app.example.com
# Internal address of the main API and the shared HMAC secret (32+ chars, same value as the API's ASC_BILLING_SECRET)
ASC_MAIN_API_URL=http://asc-api:8780
ASC_BILLING_SECRET=
# COMMERCIAL_DB=data/waitlist.sqlite
# COMMERCIAL_TRUST_PROXY=

# Stripe — US market only (USD). Off unless the secret key, webhook secret, ASC_APP_URL and the billing link are set.
# Start with test-mode keys (sk_test_..., whsec_... from the test-mode webhook endpoint).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The customer portal is opened per account from the dashboard (Stripe Billing Portal sessions)
# Optional: true only after Stripe Tax is configured in the dashboard
STRIPE_AUTOMATIC_TAX=false

# InfinitePay — Brazilian market (BRL, Pix and card). Off unless handle, API key, webhook token and an https origin are set.
# Docs: https://www.infinitepay.io/checkout-documentacao (no sandbox: tests are real R$ 1,00+ payments)
INFINITEPAY_HANDLE=
# Required (inchk_...): every link is single-use and expires; dashboard: "Habilitar checkout integrado"
INFINITEPAY_API_KEY=
# Random secret (32+ chars) added to the webhook URL; the webhook itself is unsigned.
# Exclude /api/infinitepay/webhook/ from proxy access logs (see docs/PAGAMENTOS.md)
INFINITEPAY_WEBHOOK_TOKEN=
# During a token rotation, keep the old one here until old links expire (at most 8 days)
INFINITEPAY_WEBHOOK_TOKEN_PREVIOUS=
# INFINITEPAY_RENEW_DAYS_BEFORE=5
# INFINITEPAY_GRACE_DAYS=3

# SMTP for InfinitePay renewal emails (optional: without it, run `npm run billing:report` and send links by hand)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
